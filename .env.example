# Copy to .env (git-ignored) and fill in. Read by both `docker compose` and
# the Spring Boot app. Real environment variables override these values.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=securedocs
DB_USERNAME=securedocs
DB_PASSWORD=
DB_ROOT_PASSWORD=

# HMAC key for tile tokens: at least 32 random characters.
SIGNING_SECRET=

# First admin account, created only on an empty database. Leave the password
# empty to have one generated and printed in the startup log.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Set to true when served over HTTPS.
SESSION_COOKIE_SECURE=false
